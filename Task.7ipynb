   "source": [
    "#Box & Whisker Plot\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plt.boxplot(df['Score'])\n",
    "plt.title(\"Box and Whisker Plot - Score\")\n",
    "plt.ylabel(\"Score\")\n",
    "plt.show()\n"
   ]
  },
