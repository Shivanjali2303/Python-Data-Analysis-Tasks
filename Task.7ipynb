   "source": [
    "import pandas as pd\n",
    "\n",
    "data = {\n",
    "    'Score': [35, 38, 40, 42, 45, 47, 48, 50, 52, 55, 90, 95]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "df\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "c8432e35-0f87-4340-8bb2-0bdcf06ed2f7",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(np.float64(41.5), np.float64(47.5), np.float64(52.75), np.float64(11.25))"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "#Box and Whisker plot (Outlier Detection)\n",
    "Q1 = df['Score'].quantile(0.25)\n",
    "Q2 = df['Score'].quantile(0.50)\n",
    "Q3 = df['Score'].quantile(0.75)\n",
    "\n",
    "IQR = Q3 - Q1\n",
    "\n",
    "Q1, Q2, Q3, IQR\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "237a4bcb-98e5-476c-9c7c-53804aa367cf",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(np.float64(24.625), np.float64(69.625))"
      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "#Tukey’s Method\n",
    "lower_bound = Q1 - 1.5 * IQR\n",
    "upper_bound = Q3 + 1.5 * IQR\n",
    "\n",
    "lower_bound, upper_bound\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "d69c0a72-e7a2-4978-8da9-2dcd9d13b93c",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/html": [
